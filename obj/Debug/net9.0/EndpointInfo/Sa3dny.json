  "components": {
    "schemas": {
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterCustomerDto": {
        "required": [
          "confirmPassword",
          "email",
          "locationName",
          "name",
          "password",
          "phone"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "phone": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          },
          "confirmPassword": {
            "minLength": 1,
            "type": "string"
          },
          "locationName": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterProviderDto": {
        "required": [
          "confirmPassword",
          "email",
          "governorateName",
          "locationName",
          "name",
          "nationalId",
          "nationalIdImageBase64",
          "password",
          "phone",
          "professionalLicenseBase64",
          "serviceCategoryName",
          "serviceName"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "phone": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          },
          "confirmPassword": {
            "minLength": 1,
            "type": "string"
          },
          "nationalId": {
            "maxLength": 14,
            "minLength": 0,
            "type": "string"
          },
          "governorateName": {
            "minLength": 1,
            "type": "string"
          },
          "locationName": {
            "minLength": 1,
            "type": "string"
          },
          "serviceCategoryName": {
            "minLength": 1,
            "type": "string"
          },
          "serviceName": {
            "minLength": 1,
            "type": "string"
          },
          "nationalIdImageBase64": {
            "minLength": 1,
            "type": "string"
          },
          "professionalLicenseBase64": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
